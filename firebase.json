{
  "hosting": [
    {
      "target": "shelfwise",
      "public": "dist/shelfwise",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.wasm",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/wasm"
            }
          ]
        },
        {
          "source": "**/*.@(js|wasm|png|ttf|otf)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=604800"
            }
          ]
        },
        {
          "source": "/@(index.html|manifest.json|flutter_service_worker.js|version.json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
